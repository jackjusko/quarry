{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jobs.local/schemas/resume.schema.json",
  "title": "TailoredResume",
  "type": "object",
  "required": ["contact", "summary", "experience", "education", "skills", "aiWorkflow"],
  "additionalProperties": false,
  "properties": {
    "contact": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "location": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "linkedin": { "type": "string", "format": "uri" },
        "website": { "type": "string", "minLength": 1 }
      }
    },
    "summary": { "type": "string", "minLength": 1 },
    "experience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["company", "title", "dates", "bullets"],
        "additionalProperties": false,
        "properties": {
          "company": { "type": "string", "minLength": 1 },
          "location": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "dates": { "type": "string", "minLength": 1 },
          "bullets": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["degree", "school"],
        "additionalProperties": false,
        "properties": {
          "degree": { "type": "string", "minLength": 1 },
          "school": { "type": "string", "minLength": 1 },
          "dates": { "type": "string" },
          "honors": { "type": "string" }
        }
      }
    },
    "skills": {
      "type": "object",
      "required": ["primary"],
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "additional": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "aiWorkflow": {
      "type": "string",
      "minLength": 1,
      "description": "Mandatory AI-assisted development workflow section; always included on every tailored resume."
    }
  }
}
